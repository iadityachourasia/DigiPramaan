# Legal Metrology Compliance System (LMCS) — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of the LMCS backend API (extraction pipeline, records, auth).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# When "true", the app serves src/lib/mock data instead of calling the API.
# Phase 1 has no backend, so this defaults to true during frontend build-out.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Max upload size in megabytes, surfaced in the Scan/Upload UI copy.
# BRD Q-04 is unresolved; 10 is the documented placeholder.
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Comma-separated locales the language switcher offers.
# BRD Q-03 answered: English only at launch, Hindi scaffolded but not offered.
NEXT_PUBLIC_ACTIVE_LOCALES=en

# Idle minutes before the session-expiry warning appears (WCAG 2.2.1 / A-11).
NEXT_PUBLIC_SESSION_WARN_MINUTES=25
