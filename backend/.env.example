# DigiPramaan backend — MVP environment template.
# Copy to .env and fill in real values. Never commit .env.
#
# Two supported shapes:
#
# 1. LOCAL DEV (docker-compose.yml, still available for local-only work):
#      DATABASE_URL=postgresql+psycopg://digipramaan:digipramaan@postgres:5432/digipramaan
#      S3_ENDPOINT_URL=http://minio:9000 / S3_ACCESS_KEY=minioadmin / S3_SECRET_KEY=minioadmin
#      S3_AUTO_CREATE_BUCKET=true   (MinIO's default key can create buckets)
#
# 2. MVP HOSTED (Supabase + Backblaze B2 — the internal-hackathon target):
#      DATABASE_URL = the Supabase project's Postgres connection string
#        (Project Settings -> Database -> Connection string -> URI, with the
#        `postgresql://` scheme changed to `postgresql+psycopg://` for SQLAlchemy)
#      S3_ENDPOINT_URL = https://s3.<region>.backblazeb2.com
#      S3_ACCESS_KEY / S3_SECRET_KEY = a B2 "Application Key" scoped to one bucket
#      S3_BUCKET = that bucket's name, created once in the B2 console
#      S3_AUTO_CREATE_BUCKET=false — a bucket-scoped B2 key typically has no
#        create-bucket permission at all; attempting it is a hard failure at
#        startup unless this is explicitly off.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://digipramaan:digipramaan@postgres:5432/digipramaan
TEST_DATABASE_URL=postgresql+psycopg://digipramaan:digipramaan@postgres:5432/digipramaan_test

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=digipramaan-dev
S3_REGION=us-east-1
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true

# Supabase Auth (Phase 1).
# SUPABASE_URL is optional — derived from DATABASE_URL's pooler project ref
# if omitted (see app/core/config.py's resolved_supabase_url). Set it
# explicitly only if that derivation ever stops matching your project.
# SUPABASE_ANON_KEY: Project Settings -> API -> Project API keys -> anon/public.
#   Safe by Supabase's own design to hold outside the database itself — this
#   is NOT the service-role key, which must never appear here or anywhere
#   reachable from the frontend.
# SUPABASE_JWT_SECRET: Project Settings -> API -> JWT Settings -> JWT Secret.
#   Used only for the fast local-verification path when the project signs
#   tokens with the legacy shared-secret (HS256) scheme — see
#   app/core/security.py for the newer asymmetric (JWKS) path this also
#   supports without needing this value at all.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000

# Gemini (Phase 2) — structuring stage + OCR fallback. Optional: PaddleOCR
# (confirmed GO — see app/services/ocr/paddle.py) is primary; without this
# key only the structuring pipeline stage is affected (fails cleanly,
# retryable once set). Get a key at https://aistudio.google.com/apikey.
# May be a comma-separated list of keys from SEPARATE Google Cloud
# projects — the free tier's 20 requests/day quota is enforced per
# project, so extra keys give real fallback headroom (tried in order by
# app/services/gemini_client.py) rather than sharing one exhausted quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenParser OCR migration (docs/internal/adr/0001-openparser-ocr-migration.md).
# ocr_provider now DEFAULTS to openparser (live-verified against
# paddleocr-vl-1.6, 2026-09-19 — explicit project-owner direction, cost is
# not a constraint given the configured key pool). Set OCR_PROVIDER=
# local_paddle explicitly to roll back to the original local pipeline.
# No live call is made from this repo's own test suite regardless of
# OPENPARSER_LIVE_TESTS (see that flag's own comment in app/core/config.py
# for the additional gates a live test would still need).
OCR_PROVIDER=openparser
OPENPARSER_BASE_URL=https://api.openparser.dev
OPENPARSER_API_KEY=
OPENPARSER_API_KEY_ALIAS=primary-a
OPENPARSER_TENANT_ALIAS=approved-tenant-a
# OP-Phase 3 — separate from OPENPARSER_API_KEY on purpose (spec §9); never
# sent to OpenParser, only used locally to derive idempotency keys.
OPENPARSER_IDEMPOTENCY_SECRET=
OPENPARSER_OCR_MODEL=paddleocr-vl-1.6
OPENPARSER_QUALITY_PROFILE=openparser-quality-max-v1
OPENPARSER_CONNECT_TIMEOUT_SECONDS=10
OPENPARSER_WRITE_TIMEOUT_SECONDS=120
OPENPARSER_READ_TIMEOUT_SECONDS=30
OPENPARSER_POOL_TIMEOUT_SECONDS=10
OPENPARSER_MAX_RESPONSE_BYTES=52428800
OPENPARSER_POLL_MIN_SECONDS=2
OPENPARSER_POLL_MAX_SECONDS=60
OPENPARSER_JOB_MAX_AGE_SECONDS=3600
OPENPARSER_SUBMISSION_MAX_ATTEMPTS=8
OPENPARSER_LIVE_TESTS=false
