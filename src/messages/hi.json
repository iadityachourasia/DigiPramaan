    "defaultTitle": "Legal Metrology Compliance System",
    "titleTemplate": "{page} — Legal Metrology Compliance System",
    "description": "Scan packaged commodity labels and check mandatory declarations against the Legal Metrology (Packaged Commodities) Rules, 2011. Department of Consumer Affairs, Government of India."
